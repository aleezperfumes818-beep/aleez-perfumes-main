# ==============================================================================
# ALEEZ PERFUMES - PRODUCTION ENVIRONMENT CONFIGURATION
# Fill these variables when publishing the boutique to production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# Obtain from https://supabase.com -> Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous Key (Used by browser for reading products/categories)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Secret Service Role Key (Used ONLY by Express server to decrement stock securely)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY (REAL CUSTOMER TRANSACTIONS)
# Obtain from https://dashboard.razorpay.com -> Settings -> API Keys
# Generate "Live Mode" Keys for accepting real payments into your bank account.
# ------------------------------------------------------------------------------
# Live Key ID (e.g. rzp_live_xxxxxxxxxxxxxx)
RAZORPAY_KEY_ID=rzp_live_yourLiveKeyIdHere

# Live Secret Key (Kept confidential on backend server)
RAZORPAY_KEY_SECRET=yourLiveSecretKeyHere

# Frontend Public Razorpay Key ID (Same as RAZORPAY_KEY_ID above)
VITE_RAZORPAY_KEY_ID=rzp_live_yourLiveKeyIdHere

# ------------------------------------------------------------------------------
# 3. PRODUCTION SERVER RUNTIME
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
